{
  "manifest_version": 3,
  "name": "MaxPatrol VM: устранение уязвимостей",
  "description": "Помогает устранять уязвимости в MaxPatrol VM: очередь по решениям, патчи, внешние сигналы по CVE, метрики процесса, отчет по приказу ФСТЭК 117 и задачи в Jira",
  "version": "1.2.0",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MaxPatrol VM: устранение уязвимостей",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content/api.js",
        "content/logic.js",
        "content/reports.js",
        "content/app.js",
        "content/cards.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
